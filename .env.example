# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram ID администратора/мастера (узнать у @userinfobot)
ADMIN_ID=123456789

# Название мастера/студии
MASTER_NAME=Мария - Мастер по ресницам

# Максимум записей в день (0 = без ограничений)
MAX_APPOINTMENTS_PER_DAY=10

# Напоминание за N часов до записи
REMINDER_HOURS_BEFORE=24

# ── Google Sheets (необязательно) ──────────────────────────────────────────
# ID таблицы из URL: docs.google.com/spreadsheets/d/ВОТ_ЭТА_ЧАСТЬ/edit
GOOGLE_SHEET_ID=

# Путь к JSON-файлу сервисного аккаунта (по умолчанию google_credentials.json)
GOOGLE_CREDENTIALS=google_credentials.json
